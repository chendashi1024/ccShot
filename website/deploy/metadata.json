{
  "main_module": "index.js",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [],
  "logpush": false,
  "observability": {
    "enabled": false
  },
  "bindings": [
    {
      "type": "assets",
      "name": "ASSETS"
    }
  ],
  "assets": {
    "jwt": "<由 Cloudflare 返回的静态资源上传完成凭据>",
    "config": {
      "html_handling": "auto-trailing-slash",
      "not_found_handling": "404-page",
      "run_worker_first": ["/go/*"]
    }
  }
}
