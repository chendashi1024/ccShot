{
  "name": "ccshot-site",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/go/*"]
  },
  "analytics_engine_datasets": [
    {
      "binding": "CLICKS",
      "dataset": "ccshot_clicks"
    }
  ]
}
