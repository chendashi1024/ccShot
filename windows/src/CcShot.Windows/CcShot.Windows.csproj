<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CcShot.Windows</RootNamespace>
    <AssemblyName>CcShot</AssemblyName>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ccshot.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- WPF needs PerMonitorV2 in the manifest; the WinForms analyzer only knows about ApplicationHighDpiMode. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CcShot.Core/CcShot.Core.csproj" />
    <InternalsVisibleTo Include="CcShot.Windows.Smoke" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\ccshot.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
